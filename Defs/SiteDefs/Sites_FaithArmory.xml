<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ====== Site Part Defs ====== -->

  <SitePartDef>
    <defName>FaithArmory_Weapons</defName>
    <label>weapons armory</label>
    <description>A small outpost containing a valuable weapon of advanced technology. Guarded by hostile forces.</description>
    <workerClass>HSKFaithTracker.SitePartWorker_FaithArmory</workerClass>
    <siteTexture>World/WorldObjects/Sites/Outpost</siteTexture>
    <expandingIconTexture>World/WorldObjects/Expanding/Sites/Outpost</expandingIconTexture>
    <applyFactionColorToSiteTexture>true</applyFactionColorToSiteTexture>
    <showFactionInInspectString>true</showFactionInInspectString>
    <requiresFaction>true</requiresFaction>
    <wantsThreatPoints>true</wantsThreatPoints>
    <minThreatPoints>250</minThreatPoints>
    <approachOrderString>Attack {0}</approachOrderString>
    <approachingReportString>Attacking {0}</approachingReportString>
    <tags>
      <li>FaithArmory</li>
    </tags>
  </SitePartDef>

  <SitePartDef>
    <defName>FaithArmory_Armor</defName>
    <label>armor armory</label>
    <description>A small outpost containing advanced armor. Guarded by hostile forces.</description>
    <workerClass>HSKFaithTracker.SitePartWorker_FaithArmory</workerClass>
    <siteTexture>World/WorldObjects/Sites/Outpost</siteTexture>
    <expandingIconTexture>World/WorldObjects/Expanding/Sites/Outpost</expandingIconTexture>
    <applyFactionColorToSiteTexture>true</applyFactionColorToSiteTexture>
    <showFactionInInspectString>true</showFactionInInspectString>
    <requiresFaction>true</requiresFaction>
    <wantsThreatPoints>true</wantsThreatPoints>
    <minThreatPoints>250</minThreatPoints>
    <approachOrderString>Attack {0}</approachOrderString>
    <approachingReportString>Attacking {0}</approachingReportString>
    <tags>
      <li>FaithArmory</li>
    </tags>
  </SitePartDef>

  <!-- ====== Gen Steps ====== -->

  <GenStepDef>
    <defName>FaithArmory_Weapons_Outpost</defName>
    <linkWithSite>FaithArmory_Weapons</linkWithSite>
    <order>450</order>
    <genStep Class="GenStep_Outpost">
      <size>12</size>
      <allowGeneratingThronerooms>false</allowGeneratingThronerooms>
      <allowGeneratingFarms>false</allowGeneratingFarms>
    </genStep>
  </GenStepDef>

  <GenStepDef>
    <defName>FaithArmory_Armor_Outpost</defName>
    <linkWithSite>FaithArmory_Armor</linkWithSite>
    <order>450</order>
    <genStep Class="GenStep_Outpost">
      <size>12</size>
      <allowGeneratingThronerooms>false</allowGeneratingThronerooms>
      <allowGeneratingFarms>false</allowGeneratingFarms>
    </genStep>
  </GenStepDef>

  <!-- ====== Loot Gen Steps ====== -->

  <GenStepDef>
    <defName>FaithArmory_Weapons_Loot</defName>
    <linkWithSite>FaithArmory_Weapons</linkWithSite>
    <order>455</order>
    <genStep Class="HSKFaithTracker.GenStep_FaithArmoryLoot" />
  </GenStepDef>

  <GenStepDef>
    <defName>FaithArmory_Armor_Loot</defName>
    <linkWithSite>FaithArmory_Armor</linkWithSite>
    <order>455</order>
    <genStep Class="HSKFaithTracker.GenStep_FaithArmoryLoot" />
  </GenStepDef>

  <!-- ====== Quest Script ====== -->

  <QuestScriptDef>
    <defName>FaithArmory_Quest</defName>
    <rootSelectionWeight>1.0</rootSelectionWeight>
    <rootMinPoints>250</rootMinPoints>
    <expireDaysRange>8~16</expireDaysRange>
    <questNameRules>
      <rulesStrings>
        <li>questName->[type] [place]</li>
        <li>type->Armory</li>
        <li>type->Cache</li>
        <li>type->Stash</li>
        <li>place->discovered</li>
        <li>place->detected</li>
        <li>place->spotted</li>
      </rulesStrings>
    </questNameRules>
    <questDescriptionRules>
      <rulesStrings>
        <li>questDescription->Scouts have discovered an armory nearby. It contains advanced equipment, but it's guarded by [siteFaction_pawnsPlural] of [siteFaction_name]. The camp has [sitePart0_description].</li>
      </rulesStrings>
    </questDescriptionRules>
    <root Class="QuestNode_Sequence">
      <nodes>
        <li Class="QuestNode_SubScript">
          <def>Util_RandomizePointsChallengeRating</def>
          <parms>
            <pointsFactorTwoStar>1.5</pointsFactorTwoStar>
            <pointsFactorThreeStar>2</pointsFactorThreeStar>
          </parms>
        </li>
        <li Class="QuestNode_SubScript">
          <def>Util_AdjustPointsForDistantFight</def>
        </li>
        <li Class="QuestNode_GetMap" />

        <li Class="QuestNode_GetPawn">
          <storeAs>asker</storeAs>
          <mustBeFactionLeader>true</mustBeFactionLeader>
          <allowPermanentEnemyFaction>false</allowPermanentEnemyFaction>
          <hostileWeight>0.15</hostileWeight>
        </li>

        <li Class="QuestNode_GetSiteTile">
          <storeAs>siteTile</storeAs>
          <preferCloserTiles>true</preferCloserTiles>
        </li>

        <li Class="QuestNode_GetSitePartDefsByTagsAndFaction">
          <storeAs>sitePartDefs</storeAs>
          <storeFactionAs>siteFaction</storeFactionAs>
          <sitePartsTags>
            <li><tag>FaithArmory</tag></li>
          </sitePartsTags>
          <mustBeHostileToFactionOf>$asker</mustBeHostileToFactionOf>
        </li>

        <li Class="QuestNode_GetDefaultSitePartsParams">
          <tile>$siteTile</tile>
          <faction>$siteFaction</faction>
          <sitePartDefs>$sitePartDefs</sitePartDefs>
          <storeSitePartsParamsAs>sitePartsParams</storeSitePartsParamsAs>
        </li>

        <li Class="QuestNode_SubScript">
          <def>Util_GenerateSite</def>
        </li>

        <li Class="QuestNode_SpawnWorldObjects">
          <worldObjects>$site</worldObjects>
        </li>

        <li Class="QuestNode_WorldObjectTimeout">
          <worldObject>$site</worldObject>
          <isQuestTimeout>true</isQuestTimeout>
          <delayTicks>$(randInt(8,16)*60000)</delayTicks>
          <inSignalDisable>site.MapGenerated</inSignalDisable>
          <destroyOnCleanup>true</destroyOnCleanup>
          <node Class="QuestNode_Sequence">
            <nodes>
              <li Class="QuestNode_Letter">
                <label TKey="LetterLabelQuestExpired">Quest expired: [resolvedQuestName]</label>
                <text TKey="LetterTextQuestExpired">The armory has been abandoned. The quest [resolvedQuestName] has expired.</text>
              </li>
              <li Class="QuestNode_End"><outcome>Fail</outcome></li>
            </nodes>
          </node>
        </li>

        <li Class="QuestNode_Signal">
          <inSignal>site.Destroyed</inSignal>
          <node Class="QuestNode_Sequence">
            <nodes>
              <li Class="QuestNode_Letter">
                <label TKey="LetterLabelQuestFailed">Quest failed: [resolvedQuestName]</label>
                <text TKey="LetterTextQuestFailed">The armory has been lost. The quest [resolvedQuestName] has ended.</text>
              </li>
              <li Class="QuestNode_End"><outcome>Fail</outcome></li>
            </nodes>
          </node>
        </li>

        <li Class="QuestNode_Signal">
          <inSignal>site.AllEnemiesDefeated</inSignal>
          <node Class="QuestNode_Sequence">
            <nodes>
              <li Class="QuestNode_GiveRewards">
                <parms>
                  <allowGoodwill>true</allowGoodwill>
                  <allowRoyalFavor>true</allowRoyalFavor>
                </parms>
                <addCampLootReward>true</addCampLootReward>
              </li>
            </nodes>
          </node>
        </li>
        <li Class="QuestNode_End">
          <inSignal>site.AllEnemiesDefeated</inSignal>
          <outcome>Success</outcome>
        </li>
      </nodes>
    </root>
  </QuestScriptDef>

  <!-- ====== Incident ====== -->

  <IncidentDef ParentName="GiveQuestBase">
    <defName>GiveQuest_FaithArmory</defName>
    <label>faith armory</label>
    <letterLabel>Armory discovered</letterLabel>
    <questScriptDef>FaithArmory_Quest</questScriptDef>
    <pointsScaleable>true</pointsScaleable>
    <baseChance>3.0</baseChance>
  </IncidentDef>

</Defs>
