  <!-- ====== Gen Steps ====== -->

  <GenStepDef>
    <defName>FaithArmory_Weapons_Outpost</defName>
    <linkWithSite>FaithArmory_Weapons</linkWithSite>
    <order>450</order>
    <genStep Class="GenStep_Outpost">
      <size>12</size>
      <allowGeneratingThronerooms>false</allowGeneratingThronerooms>
      <allowGeneratingFarms>false</allowGeneratingFarms>
    </genStep>
  </GenStepDef>

  <GenStepDef>
