<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <HediffDef>
        <defName>FT_GenderDominant</defName>
        <label>dominant gender</label>
        <description>As a member of the dominant gender, this colonist commands greater social influence.</description>
        <hediffClass>HediffWithComps</hediffClass>
        <defaultLabelColor>(0.5, 0.8, 1.0)</defaultLabelColor>
        <isBad>false</isBad>
        <makesAlert>false</makesAlert>
        <scenarioCanAdd>false</scenarioCanAdd>
        <initialSeverity>1.0</initialSeverity>
        <maxSeverity>1.0</maxSeverity>
        <stages>
            <li>
                <statOffsets>
                    <SocialImpact>0.15</SocialImpact>
                </statOffsets>
            </li>
        </stages>
    </HediffDef>

    <HediffDef>
        <defName>FT_GenderSubmissive</defName>
        <label>submissive gender</label>
        <description>As a member of the non-dominant gender, this colonist has diminished social standing.</description>
        <hediffClass>HediffWithComps</hediffClass>
        <defaultLabelColor>(0.7, 0.5, 0.5)</defaultLabelColor>
        <isBad>true</isBad>
        <makesAlert>false</makesAlert>
        <scenarioCanAdd>false</scenarioCanAdd>
        <initialSeverity>1.0</initialSeverity>
        <maxSeverity>1.0</maxSeverity>
        <stages>
            <li>
                <statOffsets>
                    <SocialImpact>-0.10</SocialImpact>
                </statOffsets>
            </li>
        </stages>
    </HediffDef>
</Defs>
