<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <HediffDef>
        <defName>FT_DarknessBonus</defName>
        <label>darkness empowerment</label>
        <description>Тьма усиливает последователя. Боевые способности повышены.</description>
        <hediffClass>HediffWithComps</hediffClass>
        <defaultLabelColor>(0.5, 0.6, 0.95)</defaultLabelColor>
        <isBad>false</isBad>
        <makesAlert>false</makesAlert>
        <scenarioCanAdd>false</scenarioCanAdd>
        <initialSeverity>1.0</initialSeverity>
        <maxSeverity>1.0</maxSeverity>
        <stages>
            <li>
                <statOffsets>
                    <MeleeHitChance>0.15</MeleeHitChance>
                    <ShootingAccuracyPawn>0.15</ShootingAccuracyPawn>
                    <MeleeDodgeChance>0.10</MeleeDodgeChance>
                </statOffsets>
                <statFactors>
                    <MoveSpeed>1.05</MoveSpeed>
                </statFactors>
            </li>
        </stages>
    </HediffDef>

    <HediffDef>
        <defName>FT_DeepDarknessBonus</defName>
        <label>deep darkness</label>
        <description>Глубокая тьма наполняет последователя силой. Боевые способности значительно повышены.</description>
        <hediffClass>HediffWithComps</hediffClass>
        <defaultLabelColor>(0.6, 0.7, 1.0)</defaultLabelColor>
        <isBad>false</isBad>
        <makesAlert>false</makesAlert>
        <scenarioCanAdd>false</scenarioCanAdd>
        <initialSeverity>1.0</initialSeverity>
        <maxSeverity>1.0</maxSeverity>
        <stages>
            <li>
                <statOffsets>
                    <MeleeHitChance>0.25</MeleeHitChance>
                    <ShootingAccuracyPawn>0.25</ShootingAccuracyPawn>
                    <MeleeDodgeChance>0.15</MeleeDodgeChance>
                </statOffsets>
                <statFactors>
                    <MoveSpeed>1.10</MoveSpeed>
                </statFactors>
            </li>
        </stages>
    </HediffDef>

    <HediffDef>
        <defName>FT_LightWeakness</defName>
        <label>light sensitivity</label>
        <description>Яркий свет ослепляет последователя тьмы. Боевые способности снижены.</description>
        <hediffClass>HediffWithComps</hediffClass>
        <defaultLabelColor>(0.9, 0.7, 0.3)</defaultLabelColor>
        <isBad>true</isBad>
        <makesAlert>false</makesAlert>
        <scenarioCanAdd>false</scenarioCanAdd>
        <initialSeverity>1.0</initialSeverity>
        <maxSeverity>1.0</maxSeverity>
        <stages>
            <li>
                <statOffsets>
                    <MeleeHitChance>-0.10</MeleeHitChance>
                    <ShootingAccuracyPawn>-0.10</ShootingAccuracyPawn>
                    <MeleeDodgeChance>-0.05</MeleeDodgeChance>
                </statOffsets>
                <statFactors>
                    <MoveSpeed>0.95</MoveSpeed>
                </statFactors>
                <capMods>
                    <li>
                        <capacity>Sight</capacity>
                        <offset>-0.45</offset>
                    </li>
                </capMods>
            </li>
        </stages>
    </HediffDef>
</Defs>
