<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Humanoid Alien Races</li>
		</mods>
		<match Class="PatchOperationSequence">
			<operations>
				<!-- Remove HAR_Xenophobia from specialist role requiredMemes -->
				<li Class="PatchOperationRemove">
					<success>Always</success>
					<xpath>/Defs/PreceptDef[defName="IdeoRole_ShootingSpecialist"]/requiredMemes/li[.="HAR_Xenophobia"]</xpath>
				</li>
				<li Class="PatchOperationRemove">
					<success>Always</success>
					<xpath>/Defs/PreceptDef[defName="IdeoRole_MeleeSpecialist"]/requiredMemes/li[.="HAR_Xenophobia"]</xpath>
				</li>
				<li Class="PatchOperationRemove">
					<success>Always</success>
					<xpath>/Defs/PreceptDef[defName="HMC_IdeoRole_CookingSpecialist"]/requiredMemes/li[.="HAR_Xenophobia"]</xpath>
				</li>
			</operations>
		</match>
	</Operation>
</Patch>
